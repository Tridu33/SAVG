(define (problem trashcollection_p3)
    (:domain trashcollection)
    (:objects l1 l2 l3 - LocationType t1 t2 t3 - TrashType)
    (:init
        (atDump)
        (truckEmpty)
        (trashAt l1 t1)
        (trashAt l2 t2)
        (trashAt l3 t3)
        (not (inTruck t1))
        (not (inTruck t2))
        (not (inTruck t3))
        (not (atLoc l1))
        (not (atLoc l2))
        (not (atLoc l3))
    )
    (:goal (and (atDump) (allCollected)))
)
