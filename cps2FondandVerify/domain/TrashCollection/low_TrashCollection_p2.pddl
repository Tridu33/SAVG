(define (problem trashcollection_p2)
    (:domain trashcollection)
    (:objects l1 l2 - LocationType t1 t2 - TrashType)
    (:init
        (atDump)
        (truckEmpty)
        (trashAt l1 t1)
        (trashAt l2 t2)
        (not (inTruck t1))
        (not (inTruck t2))
        (not (atLoc l1))
        (not (atLoc l2))
    )
    (:goal (and (atDump) (allCollected)))
)
